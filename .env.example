# ===== 필수 =====
# PostgreSQL 주소 (Railway: Postgres 추가 시 자동 생성되는 ${{Postgres.DATABASE_URL}} 사용)
DATABASE_URL=postgres://user:password@localhost:5432/led

# Firebase 프로젝트 ID (Firebase 콘솔 > 프로젝트 설정)
FIREBASE_PROJECT_ID=my-project-id

# Firebase 웹 앱 설정 (Firebase 콘솔 > 프로젝트 설정 > 내 앱 > firebaseConfig) — 한 줄 JSON
FIREBASE_WEB_CONFIG={"apiKey":"...","authDomain":"my-project-id.firebaseapp.com","projectId":"my-project-id","appId":"..."}

# 관리자 이메일 (쉼표로 여러 명) — 이메일 인증을 마치면 자동으로 관리자가 됩니다
ADMIN_EMAILS=ceo@mirae-esp.com

# 관리자 화면의 '사용자 추가' 기능용 서비스 계정 키 (Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성)
# 내려받은 JSON 파일 내용을 한 줄로 붙여넣기. 비밀번호와 같으니 절대 공유하지 마세요.
FIREBASE_SERVICE_ACCOUNT=

# ===== 선택 =====
# 이 도메인 이메일만 가입/로그인 허용 (비우면 제한 없음)
ALLOWED_DOMAINS=
# 이 도메인 직원은 이메일 인증 후 관리자 승인 없이 바로 사용 (비우면 모두 관리자 승인 필요)
AUTO_APPROVE_DOMAINS=
# 외부 DB에 SSL로 접속해야 할 때 true
PGSSL=false
# 포트 (Railway는 자동 지정)
PORT=3000
